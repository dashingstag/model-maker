# Pipeline working area: regenerable/cheap artifacts ignored —
# certified evidence (accepted/, processed/, unit_render/) is CHECKED IN,
# it is what the gates signed off on and cannot be regenerated exactly.
pipeline/**/candidates/*
!pipeline/**/candidates/index.json
pipeline/**/build/

# Packaged output — rebuildable
dist/

# Godot artifacts
.godot/

# Concurrency debris: lock dirs, tombstones, atomic-write temps, staging
*.lock/
*.breaking-*/
*.tmp
.publish_staging/

# Python
__pycache__/
*.pyc
