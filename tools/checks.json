  },
  "map:{arg}": {
    "cmd": "python tools/layout_map.py {arg}",
    "desc": "render resolved layout to layout_map.png",
    "arg_hint": "<goal>"
  },
  "tests:gd": {
    "cmd": "\"C:/Workspace/Godot_v4.6.3-stable_win64.exe/Godot_v4.6.3-stable_win64_console.exe\" --headless --path godot -s addons/gdUnit4/bin/GdUnitCmdTool.gd -a res://tests --ignoreHeadlessMode",
