{
  "id": "humanoid_base",
  "glb": "shared/mannequin/humanoid_base.glb",
  "skeleton": "@skeletons/humanoid_v2",
  "desc": "Canonical low-poly humanoid: 60 joints, 22 anim clips. Parts are layered: body_* slots = complete skin coverage (any outfit works) — component ids are sexed (body_m_*/body_f_*, MPFB2 skinned) while the slot/mesh-node names stay unsexed; cloth_* = garments worn over body, each declaring which body slots it covers.",
  "slots": {
    "body_head": {
      "layer": "body",
      "src": "mpfb",
      "bones": ["head", "jaw", "eye.l", "eye.r"]
    },
    "body_neck": {
      "layer": "body",
      "src": "mpfb",
      "bones": ["neck"]
    },
    "body_torso": {
      "layer": "body",
      "src": "mpfb",
      "bones": ["root", "spine", "chest", "shoulder.l", "shoulder.r"]
    },
    "body_arm_l": {
      "layer": "body",
      "src": "mpfb",
      "bones": ["upper_arm.l", "forearm.l"]
    },
    "body_arm_r": {
      "layer": "body",
      "src": "mpfb",
      "bones": ["upper_arm.r", "forearm.r"]
    },
    "body_hand_l": {
      "layer": "body",
      "src": "mpfb",
      "bones": ["hand.l", "hand.l.*"]
    },
    "body_hand_r": {
      "layer": "body",
      "src": "mpfb",
      "bones": ["hand.r", "hand.r.*"]
    },
    "body_leg_l": {
      "layer": "body",
      "src": "mpfb",
      "bones": ["thigh.l", "shin.l"]
    },
    "body_leg_r": {
      "layer": "body",
      "src": "mpfb",
      "bones": ["thigh.r", "shin.r"]
    },
    "body_foot_l": {
      "layer": "body",
      "src": "mpfb",
      "bones": ["foot.l"]
    },
    "body_foot_r": {
      "layer": "body",
      "src": "mpfb",
      "bones": ["foot.r"]
    },
    "cloth_torso": {
      "layer": "cloth",
      "covers": [
        "body_torso"
      ],
      "meshes": [
        "chest_m",
        "robe_up",
        "lapel_l",
        "lapel_r",
        "mantle"
      ]
    },
    "cloth_sleeve_l": {
      "layer": "cloth",
      "covers": [
        "body_arm_l"
      ],
      "meshes": [
        "sleeve_up_l",
        "sleeve_lo_l",
        "cuff_l"
      ]
    },
    "cloth_sleeve_r": {
      "layer": "cloth",
      "covers": [
        "body_arm_r"
      ],
      "meshes": [
        "sleeve_up_r",
        "sleeve_lo_r",
        "cuff_r"
      ]
    },
    "cloth_waist": {
      "layer": "cloth",
      "covers": [
        "body_torso"
      ],
      "meshes": [
        "pelvis",
        "sash",
        "sash_knot",
        "sash_tail_l",
        "sash_tail_r"
      ]
    },
    "cloth_skirt": {
      "layer": "cloth",
      "covers": [
        "body_leg_l",
        "body_leg_r"
      ],
      "meshes": [
        "skirt_l",
        "skirt_r",
        "apron_f"
      ]
    },
    "cloth_legs": {
      "layer": "cloth",
      "covers": [
        "body_leg_l",
        "body_leg_r"
      ],
      "meshes": [
        "hakama_l",
        "hakama_r"
      ]
    },
    "cloth_feet": {
      "layer": "cloth",
      "covers": [
        "body_foot_l",
        "body_foot_r"
      ],
      "meshes": [
        "foot_l",
        "foot_r"
      ]
    },
    "std_hair": {
      "layer": "hair",
      "meshes": [
        "hair_cap",
        "hair_fall",
        "lock_l",
        "lock_r",
        "topknot",
        "hairpin"
      ]
    },
    "std_ornament": {
      "layer": "ornament",
      "meshes": [
        "crown",
        "crown_fin",
        "brow_gem"
      ]
    }
  }
}